 005E				PRINT_ITEM PROC
 005E  50			    PUSH AX          ; 保护要打印的数值 (保存在栈中)
 005F  B4 09			    MOV AH, 09H
 0061  CD 21			    INT 21H          ; DOS 9号调用：打印字符串
				    
 0063  58			    POP AX           ; 恢复数值到 AL
 0064  B4 00			    MOV AH, 0        ; 确保 AX = 该数值
 0066  B3 0A			    MOV BL, 10
 0068  33 C9			    XOR CX, CX       ; CX 清零，用于记录压栈的位数
 006A				DIV_LOOP:
 006A  F6 F3			    DIV BL           ; AX / 10
 006C  50			    PUSH AX          ; 余数在 AH 中，压栈保存
 006D  B4 00			    MOV AH, 0        ; 清除余数，保留商在 AL 中继续除
 006F  41			    INC CX           ; 位数 + 1
 0070  3C 00			    CMP AL, 0
 0072  75 F6			    JNZ DIV_LOOP     ; 商不为0则继续拆分
 0074				PRINT_DIGITS:
 0074  5A			    POP DX           ; 弹出栈顶数据
 0075  8A D6			    MOV DL, DH       ; 刚才的余数在 AH，弹出后到了 DH，现移给 DL
 0077  80 C2 30			    ADD DL, 30H      ; 转为 ASCII 码字符
 007A  B4 02			    MOV AH, 02H
 007C  CD 21			    INT 21H          ; DOS 2号调用：逐位打印数字
 007E  E2 F4			    LOOP PRINT_DIGITS
 0080  C3			    RET
 0081				PRINT_ITEM ENDP

 0081				CODES ENDS
				END START

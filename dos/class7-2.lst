				; 实验1：8255方式1输出口程序
				.MODEL SMALL
 0000				.DATA
 = 0288				    PORT_A      EQU 288H    ; 8255 PA口地址
 = 028B				    PORT_CTRL   EQU 28BH    ; 8255 控制口地址
 0000 0000			    OLD_INT_SEG DW ?        ; 保存原中断向量段地址
 0002 0000			    OLD_INT_OFF DW ?        ; 保存原中断向量偏移地址
 0004 01			    DATA_VAL    DB 01H      ; 初始输出数据，设为01H

 0000				.CODE
 0000				START:
 0000  B8 ---- R		    MOV AX, @DATA
 0003  8E D8			    MOV DS, AX

				    ; 1. 保存原IRQ3 (INT 0BH) 的中断向量
 0005  B8 350B			    MOV AX, 350BH
 0008  CD 21			    INT 21H
 000A  89 1E 0002 R		    MOV OLD_INT_OFF, BX
 000E  8C 06 0000 R		    MOV OLD_INT_SEG, ES

				    ; 2. 设置新的IRQ3中断向量，指向自定义的中断服务程序
 0012  1E			    PUSH DS
 0013  B8 ---- R		    MOV AX, SEG OUT_ISR
 0016  8E D8			    MOV DS, AX
 0018  BA 004A R		    MOV DX, OFFSET OUT_ISR
 001B  B8 250B			    MOV AX, 250BH
 001E  CD 21			    INT 21H
 0020  1F			    POP DS

				    ; 3. 解除8259对IRQ3的屏蔽 (修改IMR寄存器)
 0021  E4 21			    IN AL, 21H
 0023  24 F7			    AND AL, 0F7H            ; 将位3清零，允许IRQ3中断
 0025  E6 21			    OUT 21H, AL

				    ; 4. 初始化8255：A口方式1输出
				    ; 控制字：1(特征位) 01(A口方式1) 0(A口输出) 0(C上半部输出) 0(B口方式0) 0(B口输出) 0(C下半部输出)
 0027  BA 028B			    MOV DX, PORT_CTRL
 002A  B0 A0			    MOV AL, 0A0H            
 002C  EE			    OUT DX, AL

				    ; 5. 使能8255的INTE A (对于A口输出，由PC6置位实现)
				    ; 置位/复位控制字：0(特征位) 000 110(选择PC6) 1(置位) = 0DH
 002D  B0 0D			    MOV AL, 0DH             
 002F  EE			    OUT DX, AL

				    ; 6. 等待中断循环
 0030				WAIT_LOOP:
 0030  80 3E 0004 R 00		    CMP DATA_VAL, 0         ; 判断DATA_VAL是否移位至0 (8次中断后01H左移8次变0)
 0035  75 F9			    JNZ WAIT_LOOP           ; 未结束则继续等待

				    ; 7. 恢复原中断向量和环境并退出程序
 0037  C5 16 0002 R		    LDS DX, DWORD PTR OLD_INT_OFF
 003B  B8 250B			    MOV AX, 250BH
 003E  CD 21			    INT 21H

 0040  E4 21			    IN AL, 21H              ; 恢复IRQ3屏蔽
 0042  0C 08			    OR AL, 08H
 0044  E6 21			    OUT 21H, AL

 0046  B4 4C			    MOV AH, 4CH             ; 返回DOS
 0048  CD 21			    INT 21H

				; --- 中断服务程序 ---
 004A				OUT_ISR PROC FAR
 004A  50			    PUSH AX
 004B  52			    PUSH DX

				    ; 将数据从A口输出到LED
 004C  BA 0288			    MOV DX, PORT_A
 004F  A0 0004 R		    MOV AL, DATA_VAL
 0052  EE			    OUT DX, AL

				    ; 数据左移一位，为下一次中断准备 (01H -> 02H -> 04H... -> 80H -> 00H)
 0053  D0 26 0004 R		    SHL DATA_VAL, 1         

				    ; 向8259发送中断结束命令(EOI)
 0057  B0 20			    MOV AL, 20H
 0059  E6 20			    OUT 20H, AL

 005B  5A			    POP DX
 005C  58			    POP AX
 005D  FB			    STI                     ; 开中断
 005E  CF			    IRET                    ; 中断返回
 005F				OUT_ISR ENDP

				END START

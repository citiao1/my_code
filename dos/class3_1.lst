				    ASSUME CS:CODES,DS:DATAS,SS:STACKS
 0000				START:
 0000  B8 ---- R		    MOV AX, DATAS
 0003  8E D8			    MOV DS, AX

				    ; 1. 打印提示信息
 0005  8D 16 0000 R		    LEA DX, PROMPT
 0009  B4 09			    MOV AH, 09H
 000B  CD 21			    INT 21H

				    ; 2. 接收字符串输入
 000D  8D 16 002B R		    LEA DX, MAX_LEN
 0011  B4 0A			    MOV AH, 0AH
 0013  CD 21			    INT 21H

				    ; 3. 准备遍历统计
 0015  8A 0E 002C R		    MOV CL, ACT_LEN      ; 把实际输入的字符数量放进 CX 作为循环次数
 0019  B5 00			    MOV CH, 0            ; 高位清零，保证 CX 的值就是实际长度
 001B  E3 15			    JCXZ FINISH          ; 如果没输入任何字符 (CX=0)，直接跳到结束
				    
 001D  8D 1E 002D R		    LEA BX, BUFFER       ; BX 指向字符串真正的开头
 0021  B2 00			    MOV DL, 0            ; 用 DL 作为数字字符的计数器，初始为 0

 0023				COUNT_LOOP:
 0023  8A 07			    MOV AL, [BX]         ; 取出一个字符放到 AL
 0025  3C 30			    CMP AL, '0'
 0027  72 06			    JB NEXT_CHAR         ; 小于 '0'，不是数字，跳过
 0029  3C 39			    CMP AL, '9'
 002B  77 02			    JA NEXT_CHAR         ; 大于 '9'，不是数字，跳过
 002D  FE C2			    INC DL               ; 走到这里说明是数字，计数器 +1

 002F				NEXT_CHAR:
 002F  43			    INC BX               ; BX 指向下一个字符
 0030  E2 F1			    LOOP COUNT_LOOP      ; CX 减 1，如果不为 0 则跳回 COUNT_LOOP 继续

 0032				FINISH:
				    ; 4. 打印结果提示
 0032  52			    PUSH DX              ; 暂存计数器 DL 的值
 0033  8D 16 0018 R		    LEA DX, RES_MSG
 0037  B4 09			    MOV AH, 09H
 0039  CD 21			    INT 21H
 003B  5A			    POP DX               ; 恢复计数器 DL 的值

				    ; 5. 把 DL 里的个数打印出来 (除以 10 拆分十位和个位)
 003C  8A C2			    MOV AL, DL
 003E  B4 00			    MOV AH, 0
 0040  B3 0A			    MOV BL, 10
 0042  F6 F3			    DIV BL               ; AX / 10，商(十位)在AL，余数(个位)在AH
 0044  8B D8			    MOV BX, AX           ; 暂存结果到 BX
				    
 0046  8A D3			    MOV DL, BL           ; 打印十位
 0048  80 C2 30			    ADD DL, 30H
 004B  B4 02			    MOV AH, 02H
 004D  CD 21			    INT 21H
				    
 004F  8A D7			    MOV DL, BH           ; 打印个位
 0051  80 C2 30			    ADD DL, 30H
 0054  B4 02			    MOV AH, 02H
 0056  CD 21			    INT 21H

				    ; 退出程序
 0058  B4 4C			    MOV AH, 4CH
 005A  CD 21			    INT 21H
 005C				CODES ENDS

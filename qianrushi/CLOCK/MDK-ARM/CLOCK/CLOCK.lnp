"clock\main.o"
"clock\gpio.o"
"clock\rtc.o"
"clock\tim.o"
"clock\usart.o"
"clock\stm32g4xx_it.o"
"clock\stm32g4xx_hal_msp.o"
"clock\stm32g4xx_hal_rtc.o"
"clock\stm32g4xx_hal_rtc_ex.o"
"clock\stm32g4xx_hal.o"
"clock\stm32g4xx_hal_rcc.o"
"clock\stm32g4xx_hal_rcc_ex.o"
"clock\stm32g4xx_hal_flash.o"
"clock\stm32g4xx_hal_flash_ex.o"
"clock\stm32g4xx_hal_flash_ramfunc.o"
"clock\stm32g4xx_hal_gpio.o"
"clock\stm32g4xx_hal_exti.o"
"clock\stm32g4xx_hal_dma.o"
"clock\stm32g4xx_hal_dma_ex.o"
"clock\stm32g4xx_hal_pwr.o"

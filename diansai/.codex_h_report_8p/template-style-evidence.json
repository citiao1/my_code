    },
    {
      "para_index": 7,
      "text": "\u5173\u952e\u8bcd\uff1a\u3010\u8bf7\u586b\u51993\u20145\u4e2a\uff0c\u4f8b\u5982\uff1a\u5faa\u8ff9\u63a7\u5236\uff1b\u673a\u5668\u89c6\u89c9\uff1b\u7403\u6746\u7cfb\u7edf\uff1b\u72b6\u6001\u4f30\u8ba1\uff1b\u6297\u6270\u63a7\u5236\u3011",

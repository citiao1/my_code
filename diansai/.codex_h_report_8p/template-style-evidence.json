    },
    {
      "para_index": 36,
      "text": "\u8f66\u8f7d\u5e73\u8861\u6eda\u7403\u8fd0\u52a8\u63a7\u5236\u7cfb\u7edf\uff08H\u9898\uff09",
      "style": "Normal"
    },
    {
      "para_index": 43,
      "text": "\u88681 \u9898\u76ee\u6307\u6807\u4e0e\u672c\u961f\u8bbe\u8ba1\u5bf9\u5e94\u5173\u7cfb",
      "style": "Normal"
    },
    {
      "para_index": 48,
      "text": "\u65b9\u6848\u9009\u62e9\uff1a\u3010\u8bf7\u586b\u5199\uff1a\u660e\u786e\u6700\u7ec8\u91c7\u7528\u54ea\u4e00\u65b9\u6848\uff1b\u81f3\u5c11\u7ed9\u51fa\u4e24\u6761\u53ef\u9a8c\u8bc1\u7684\u9009\u62e9\u4f9d\u636e\uff0c\u4e0d\u8981\u4f7f\u7528\u201c\u6548\u679c\u66f4\u597d\u201d\u8fd9\u7c7b\u65e0\u91cf\u5316\u8868\u8ff0\u3002\u3011",
      "style": "Normal"
    },
    {
      "para_index": 52,
      "text": "\u9009\u62e9\u7ed3\u8bba\uff1a\u3010\u8bf7\u586b\u5199\uff1a\u5199\u51fa\u6700\u7ec8\u7b97\u6cd5\u6d41\u7a0b\u548c\u9009\u62e9\u7406\u7531\uff0c\u5e76\u8bf4\u660e\u5176\u6ee1\u8db3\u201c\u5fc5\u987b\u4f7f\u7528\u6444\u50cf\u5934\u68c0\u6d4b\u7403\u4f4d\u201d\u7684\u7ea6\u675f\u3002\u3011",
      "style": "Normal"
    },
    {
      "para_index": 56,
      "text": "\u6700\u7ec8\u65b9\u6848\uff1a\u3010\u8bf7\u586b\u5199\uff1a\u7528\u201c\u5bf9\u8c61\u2014\u4f20\u611f\u2014\u63a7\u5236\u5668\u2014\u6267\u884c\u2014\u53cd\u9988\u201d\u95ed\u73af\u903b\u8f91\u63cf\u8ff0\u6700\u7ec8\u63a7\u5236\u94fe\u3002\u3011",
      "style": "Normal"
    },
    {
      "para_index": 65,
      "text": "\u65f6\u95f4\u9884\u7b97\uff1a\u3010\u8bf7\u586b\u5199\uff1a\u6309\u672c\u961f\u76f4\u7ebf\u901f\u5ea6____m/s\u3001\u5f2f\u9053\u901f\u5ea6____m/s\u3001\u52a0\u51cf\u901f\u65f6\u95f4____s\u8ba1\u7b97\u7406\u8bba\u4e00\u5708____s\uff0c\u5e76\u8bf4\u660e\u76f8\u5bf920 s\u621630 s\u6307\u6807\u7684\u88d5\u91cf\u3002\u3011",
      "style": "Normal"
    },
    {
      "para_index": 72,
      "text": "\u63a7\u5236\u542b\u4e49\uff1a\u3010\u8bf7\u586b\u5199\uff1a\u6839\u636e\u6a21\u578b\u89e3\u91ca\u7cfb\u7edf\u4e3a\u4f55\u9700\u8981\u901f\u5ea6\u53cd\u9988/\u963b\u5c3c\uff0c\u4ee5\u53ca\u5c0f\u8f66\u8d77\u6b65\u3001\u5f2f\u9053\u548c\u5236\u52a8\u5206\u522b\u4ea7\u751f\u4f55\u79cd\u6270\u52a8\u3002\u3011",
      "style": "Normal"
    },
    {
      "para_index": 77,
      "text": "\u5206\u8fa8\u7387\u6838\u7b97\uff1a\u3010\u8bf7\u586b\u5199\uff1a\u89c6\u573a\u957f\u5ea6____cm\u5bf9\u5e94____pixel\uff0c\u7406\u8bba\u5206\u8fa8\u7387____cm/pixel\uff1b\u7ed3\u5408\u5b9e\u6d4b\u91cd\u590d\u6027\u8bf4\u660e\u80fd\u5426\u652f\u63011 cm\u8bef\u5dee\u6307\u6807\u3002\u3011",
      "style": "Normal"
    },
    {
      "para_index": 84,
      "text": "\u88682 \u5173\u952e\u8bbe\u8ba1\u53c2\u6570\u4e0e\u6307\u6807\u9884\u7b97",
      "style": "Normal"
    },

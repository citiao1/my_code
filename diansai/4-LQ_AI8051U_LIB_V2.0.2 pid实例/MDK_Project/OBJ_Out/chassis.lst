  186           * @brief 计算循迹偏差
  187           * 根据苯环状态机，动态切换差比和权重，欺骗 PID 做出特定转向动作
  188           */
  189          int Calculate_Deviation(void) 
  190          {
  191   1          int* adc = GetInductance(); // 简化指针名称，方便书写
  192   1          float eleSub = 0;
  193   1          float eleAdd = 0;
  194   1          float eleValue = 0;
  195   1          static uint16 off_track_timer = 0;
  196   1      
  197   1          if(stop_flag == 1) return 0;
  198   1      
  199   1          // =========================================================================
  200   1          // 🌟 核心控制层：状态机多路复用权重分配
  201   1          // =========================================================================
  202   1          if (loop_state == LOOP_NORMAL)
  203   1          {
  204   2              // 【正常巡线】原汁原味的差比和
  205   2              eleSub = (adc[0] + adc[1]) - (adc[3] + adc[4]);
  206   2              eleAdd = adc[0] + adc[1] + adc[2] + adc[3] + adc[4] + 10;
  207   2          }
  208   1          else if (loop_state == LOOP_APPROACH)
  209   1          {
  210   2              // 【逼近阶段】屏蔽最外侧电感 (adc[0]和adc[3])，防止被侧边圆环的磁场提�
             -��“吸”偏
  211   2              eleSub = adc[1] - adc[4];
  212   2      //        eleAdd = adc[1] + adc[2] + adc[4] + 10;
  213   2      //          eleSub = (adc[0] + adc[1]) - (adc[3] + adc[4]);
  214   2                eleAdd = adc[0] + adc[1] + adc[2] + adc[3] + adc[4] + 10;
  215   2          }
  216   1          else if (loop_state == LOOP_TURN_IN)
  217   1          {
  218   2              // 【强制入环】制造巨大假偏差，瞬间拉满 PID！
  219   2              if (loop_type == LOOP_RIGHT)
  220   2              {
  221   3                  // 进左环：极度削弱左侧，放大右侧。制造“严重偏右”的假象，强迫
             -车猛向左打死！
  222   3                  eleSub = (0.2f * adc[0] + 0.5f * adc[1]) - (1.8f * adc[3] + 1.5f * adc[4]);
  223   3              }
  224   2              else if (loop_type == LOOP_LEFT)
  225   2              {
  226   3                  // 进右环：极度放大左侧，削弱右侧。制造“严重偏左”的假象，强迫
             -车猛向右打死！
  227   3                  eleSub = (1.8f * adc[0] + 1.5f * adc[1]) - (0.2f * adc[3] + 0.5f * adc[4]);
  228   3              }
  229   2              eleAdd = adc[0] + adc[1] + adc[2] + adc[3] + adc[4] + 10;
  230   2          }
  231   1          else if (loop_state == LOOP_IN_LOOP)
  232   1          {
  233   2              // 【环内巡线】微调权重，防止被离心力甩出
  234   2      //        if (loop_type == LOOP_RIGHT)
  235   2      //        {
  236   2      //            // 左环内，适度放大右侧，让车有持续向左靠拢（贴内侧）的趋势
  237   2      //            eleSub = (0.8f * adc[0] + 0.8f * adc[1]) - (1.2f * adc[3] + 1.2f * adc[4]);
  238   2      //        }
  239   2      //        else 
  240   2      //        {
  241   2      //            // 右环内，适度放大左侧，让车有持续向右靠拢的趋势
  242   2      //            eleSub = (1.2f * adc[0] + 1.2f * adc[1]) - (0.8f * adc[3] + 0.8f * adc[4]);
  243   2      //        }
  244   2              eleSub = (adc[0] + adc[1]) - (adc[3] + adc[4]);
  245   2              eleAdd = adc[0] + adc[1] + adc[2] + adc[3] + adc[4] + 10;
  246   2          }
  247   1          else if (loop_state == LOOP_EXITING)
  248   1          {

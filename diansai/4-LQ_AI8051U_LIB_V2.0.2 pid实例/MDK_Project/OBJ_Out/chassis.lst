  249   2              // 【强制出环】反向拉扯，把车头强制拽出圆环
  250   2              if (loop_type == LOOP_RIGHT)
  251   2              {
  252   3                  // 左环出环：放大左侧权重，送给 PID 正偏差，强迫车头向右转（拉直�
             -��环）
  253   3                  eleSub = (1.5f * adc[0] + 1.5f * adc[1]) - (0.5f * adc[3] + 0.5f * adc[4]);
  254   3              }
  255   2              else 
  256   2              {
  257   3                  // 右环出环：放大右侧权重，强迫车头向左转
  258   3                  eleSub = (0.5f * adc[0] + 0.5f * adc[1]) - (1.5f * adc[3] + 1.5f * adc[4]);
  259   3              }
  260   2              eleAdd = adc[0] + adc[1] + adc[2] + adc[3] + adc[4] + 10;
  261   2          }
  262   1          // =========================================================================
  263   1      
  264   1          // 丢线保护逻辑 (保持原样不动)
  265   1          if(eleAdd < 20.0)
  266   1          {
  267   2              off_track_timer++;
  268   2              if(off_track_timer >= 250) stop_flag = 1;
  269   2          }
  270   1          else
  271   1          {
  272   2              off_track_timer = 0;
  273   2          }
  274   1      
  275   1          // 归一化偏差值计算
  276   1          eleValue = (float)eleSub / (float)eleAdd * 100.0f;
  277   1      
  278   1          // 限幅处理：将偏差值限制在 -100 到 100 之间
  279   1          if(eleValue > 100.0f) eleValue = 100.0f;
  280   1          else if(eleValue < -100.0f) eleValue = -100.0f;
  281   1      
  282   1          // 转换为整型返回给控制层
  283   1          return (int)(eleValue);

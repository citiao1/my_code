   89   1          while (Soft_I2C_SDA_READ(cfg->sda))
   90   1          {
   91   2              ucErrTime++;
   92   2              if (ucErrTime > 100)
   93   2              {
   94   3                  soft_i2c_stop(cfg);
   95   3                  return 1;
   96   3              }
   97   2          }
   98   1          Soft_I2C_SCL_L(cfg->scl); // 时钟输出0
   99   1          return 0;
  100   1      }

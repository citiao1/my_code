    6          /**
    7           * @brief ADC 值归一化
    8           * 将 ADC 值归一化到指定范围
    9           * @param value ADC 值
   10           * @param min 最小值
   11           * @param max 最大值
   12           * @return 归一化后的值
   13           */
   14          int _adcNormalize(int value, double min, double max)
   15          {
   16   1          double normalized = (double)(value - min) / (max - min)* 100.0;
   17   1          if(normalized > 100.0) normalized = 100.0;
   18   1          if(normalized < 1.0) normalized = 1.0;
   19   1          return (int)normalized;
   20   1      }
   21          /**
   22           * @brief 去极值平均滤波函数
   23           * 连续采样 5 次，去掉最大值和最小值，其余取平均
   24           * @param ch ADC通道号
   25           * @return 滤波后的有效ADC值
   26           */
   27          int Get_Filtered_ADC(uint8 ch)
   28          {
   29   1          int i;
   30   1          int temp;
   31   1          int sum = 0;
   32   1          int max_val = 0;
   33   1          int min_val = 65535; // 赋初值为理论最大可能值
   34   1      
   35   1          // 连续采样 5 次
   36   1          for (i = 0; i < 3; i++)
   37   1          {
   38   2              temp = Get_ADCResult(ch);
   39   2              sum += temp;
   40   2              
   41   2              // 筛选最大值和最小值
   42   2              if (temp > max_val) max_val = temp;
   43   2              if (temp < min_val) min_val = temp;
   44   2          }
   45   1      
   46   1          // 减去极值后取平均 (总和 - 最大 - 最小) / 3
   47   1          return (sum - max_val - min_val) / 3;
   48   1      }

  126          /**
  127           * @brief 向LSM6DSR传感器写入寄存器值
  128           * @param reg 要写入的寄存器地址
  129           * @param val 要写入的寄存器值
  130           * @note 此函数通过SPI接口与LSM6DSR传感器通信
  131           *       1. 拉低片选信号
  132           *       2. 发送寄存器地址(bit7=0表示写操作)
  133           *       3. 发送要写入的数据
  134           *       4. 拉高片选信号
  135           */
  136          void LSM6DSR_SPI_WriteReg(u8 reg, u8 val)
  137          {
  138   1          LSM6DSR_CS_STA(LOW);  // 拉低片选信号,选中主线占用
  139   1          SPI_WriteByte(reg);   // 寄存器地址（bit7=0 表示写）
  140   1          SPI_WriteByte(val);   // 数据
  141   1          LSM6DSR_CS_STA(HIGH); // 拉高片选信号,解除主线占用
  142   1      }
  143          
  144          /**
  145           * @brief 从LSM6DSR传感器读取指定寄存器的值
  146           *
  147           * @param reg 要读取的寄存器地址
  148           * @return u8 读取到的寄存器值
  149           *
  150           * @note 该函数通过SPI接口与LSM6DSR传感器通信
  151           *       1. 拉低CS片选信号开始通信
  152           *       2. 发送寄存器地址(bit7=1表示读操作)
  153           *       3. 读取寄存器值(需虚写一字节时钟)
  154           *       4. 拉高CS片选信号结束通信
  155           */
  156          u8 LSM6DSR_SPI_ReadReg(u8 reg)
  157          {
  158   1          u8 val;
  159   1          LSM6DSR_CS_STA(LOW);
  160   1          SPI_WriteByte(reg | 0x80); // bit7=1 表示读
  161   1          val = SPI_ReadByte();      // 虚写一字节时钟，同时读回数据
  162   1          LSM6DSR_CS_STA(HIGH);
  163   1          return val;
  164   1      }

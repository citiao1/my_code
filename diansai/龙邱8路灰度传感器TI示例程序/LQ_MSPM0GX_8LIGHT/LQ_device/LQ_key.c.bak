#include "LQ_key.h"

void gpio_Key_Init()
{
    // 初始化GPIOB.14为输入模式
    DL_GPIO_initDigitalInputFeatures(Key_K0_IOMUX, DL_GPIO_INVERSION_DISABLE, DL_GPIO_RESISTOR_NONE, DL_GPIO_HYSTERESIS_DISABLE, DL_GPIO_WAKEUP_DISABLE);
    // 初始化GPIOB.8为输入模式
    DL_GPIO_initDigitalInputFeatures(Key_K1_IOMUX, DL_GPIO_INVERSION_DISABLE, DL_GPIO_RESISTOR_NONE, DL_GPIO_HYSTERESIS_DISABLE, DL_GPIO_WAKEUP_DISABLE);
    // 初始化GPIOB.15为输入模式
    DL_GPIO_initDigitalInputFeatures(Key_K2_IOMUX, DL_GPIO_INVERSION_DISABLE, DL_GPIO_RESISTOR_NONE, DL_GPIO_HYSTERESIS_DISABLE, DL_GPIO_WAKEUP_DISABLE);
    // 设置GPIOB.14、GPIOB.8、GPIOB.15为输入模式
    DL_GPIO_setLowerPinsInputFilter(Key_PORT, DL_GPIO_PIN_14_INPUT_FILTER_8_CYCLES | DL_GPIO_PIN_8_INPUT_FILTER_8_CYCLES | DL_GPIO_PIN_15_INPUT_FILTER_8_CYCLES);
    // 启用GPIOB.14、GPIOB.8、GPIOB.15的输入功能
    DL_GPIO_enableInput(Key_PORT, Key_K0_PIN | Key_K1_PIN | Key_K2_PIN);
    // 启用GPIOB.14、GPIOB.8、GPIOB.15的中断功能
    DL_GPIO_enableInterrupt(Key_PORT, Key_K0_PIN | Key_K1_PIN | Key_K2_PIN);
    // 设置GPIOB.14、GPIOB.8、GPIOB.15的中断触发方式为下降沿触发
    DL_GPIO_setInterruptTrigger(Key_PORT, Key_K0_PIN | Key_K1_PIN | Key_K2_PIN, DL_GPIO_INT_TRIGGER_FALLING_EDGE);
    // 设置GPIOB.14、GPIOB.8、GPIOB.15的中断优先级为最高
    DL_GPIO_setInterruptPriority(Key_PORT, Key_K0_PIN | Key_K1_PIN | Key_K2_PIN, DL_GPIO_INT_PRIORITY_HIGH);
}
